[Unit]
Description=Dell Realtek Bluetooth Audio Sentinel & Optimizer
After=pipewire.service wireplumber.service

[Service]
Type=simple
# Tip: Executing 'bt-dell-audio install-service' automatically detects and links your exact binary path
ExecStart=%h/.local/bin/bt-dell-audio daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
